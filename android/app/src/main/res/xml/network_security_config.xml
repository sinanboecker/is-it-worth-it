<?xml version="1.0" encoding="utf-8"?>
<!-- The server runs on the home network over plain HTTP at an address the user types in,
     so cleartext has to be allowed for any host. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
