<?xml version="1.0"?>
<!-- Unraid template. The image is published to ghcr.io by GitHub Actions for every release tag (see README).
     Copy to /boot/config/plugins/dockerMan/templates-user/my-is-it-worth-it.xml, then Docker > Add Container > pick "is-it-worth-it".
     Use :latest for automatic updates, or a fixed version (e.g. :0.2.0) to stay on / roll back to it. -->
<Container version="2">
  <Name>is-it-worth-it</Name>
  <Repository>ghcr.io/sinanboecker/is-it-worth-it:latest</Repository>
  <Registry>https://github.com/sinanboecker/is-it-worth-it/pkgs/container/is-it-worth-it</Registry>
  <Support>https://github.com/sinanboecker/is-it-worth-it/issues</Support>
  <Project>https://github.com/sinanboecker/is-it-worth-it</Project>
  <Icon>https://raw.githubusercontent.com/sinanboecker/is-it-worth-it/main/unraid/icon.png</Icon>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Self-hosted tracker for games and gaming hardware: purchases, playtime per device, cost per hour, journal and wishlist. LAN / WireGuard only, no login.</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams/>
  <Config Name="Web UI port" Target="8080" Default="8080" Mode="tcp" Description="Port of the web app and the API" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/is-it-worth-it" Mode="rw" Description="Database, covers, uploads, backups" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/is-it-worth-it</Config>
  <Config Name="Allowed networks" Target="ALLOWED_NETWORKS" Default="" Mode="" Description="Comma-separated source networks that may use the app, e.g. 192.168.178.0/24,10.253.0.0/24 (LAN + WireGuard). Empty = all private ranges." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="RAWG API key" Target="RAWG_API_KEY" Default="" Mode="" Description="Free key from rawg.io for game info and images (optional)" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Time zone" Target="TZ" Default="Europe/Berlin" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Berlin</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User id that owns the files in /data" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group id that owns the files in /data" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
</Container>
